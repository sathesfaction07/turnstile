<?xml version="1.0" encoding="UTF-8"?>
<TargetEndpoint name="default">
  <Description>The gateway on Cloud Run, reached privately: the service accepts traffic only from the internal load balancer, so the agent's own Authorization header passes through untouched to the gateway, which verifies it.</Description>
  <PreFlow name="PreFlow">
    <Request/>
    <Response/>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPTargetConnection>
    <Properties>
      <Property name="io.timeout.millis">30000</Property>
    </Properties>
    <SSLInfo>
      <Enabled>true</Enabled>
      <Enforce>true</Enforce>
      <IgnoreValidationErrors>false</IgnoreValidationErrors>
    </SSLInfo>
    <!-- Target server "turnstile-gateway" is defined per environment (the internal load
         balancer's address), so the same bundle deploys to test and production. -->
    <LoadBalancer>
      <Server name="turnstile-gateway"/>
    </LoadBalancer>
    <Path>/mcp</Path>
  </HTTPTargetConnection>
</TargetEndpoint>
