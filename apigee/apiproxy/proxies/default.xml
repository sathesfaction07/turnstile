<?xml version="1.0" encoding="UTF-8"?>
<ProxyEndpoint name="default">
  <Description>Agents call POST /turnstile/mcp with x-api-key (identifies the team) and Authorization: Bearer (identifies the agent to the gateway).</Description>
  <FaultRules>
    <FaultRule name="rate-limited">
      <Condition>(fault.name = "SpikeArrestViolation") or (fault.name = "QuotaViolation")</Condition>
      <Step>
        <Name>AM-RateLimitedResponse</Name>
      </Step>
    </FaultRule>
  </FaultRules>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>RF-MethodNotAllowed</Name>
        <Condition>request.verb != "POST"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
      </Step>
      <Step>
        <Name>SA-SpikeArrest</Name>
      </Step>
      <Step>
        <Name>Q-DailyQuota</Name>
      </Step>
      <Step>
        <Name>JTP-JSONThreatProtection</Name>
      </Step>
      <Step>
        <Name>AM-StripAPIKey</Name>
      </Step>
      <Step>
        <Name>AM-AddClientHeader</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>AM-RemoveServerHeaders</Name>
      </Step>
    </Response>
  </PreFlow>
  <Flows/>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/turnstile</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
